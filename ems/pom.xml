<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================================
         EMS — Event Management Service (rewrite: Scala → Java 17 / Spring Boot)
         Trigger-plan Phase A. Thin, rule-free ingest + query service.
         See ems-design.md (build-ready design) and ems/README.md (phase board).
         ======================================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.orchestration</groupId>
    <artifactId>ems</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ems</name>
    <description>Event Management Service — trigger-plan Phase A</description>

    <properties>
        <java.version>17</java.version>
        <!-- Failsafe tag filter. Default: run every IT except the §12 perf harness. -Pperf inverts it. -->
        <ems.it.groups />
        <ems.it.excludedGroups>perf</ems.it.excludedGroups>
        <!-- Pins that the design calls out explicitly (ems-design §10). Version bumps are a
             deliberate, reviewed act — the CEL engine version is a recomputability anchor
             recorded in routing_decision.engine_version, and must stay in lock-step with the
             celpy pin on the framework side via the shared conformance suite (§7). -->
        <cel-java.version>0.4.4</cel-java.version>
        <jcs.version>1.1</jcs.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <wiremock.version>3.9.2</wiremock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web (query API: /event, /run/status, /gate/groups, admin) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security (ems-design §4.3 "Auth"): OAuth2 resource server (Entra JWT + group claims) with
             an HTTP Basic fallback, mirroring the legacy AuthorizationManager modes
             (Basic / Bearer-JWT-with-group-checks / none). The resource-server starter brings
             spring-security-oauth2-jose (Nimbus), which also signs the local POST /token. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence: JdbcClient (no ORM — ems-design §5), Postgres, Flyway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Kafka ingest: manual ack, ErrorHandlingDeserializer, poison-only DLQ (§4.2 / A1) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Caffeine: context cache (ems-design §4) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- CEL (cel-java, exact version pinned) — subscription evaluation (§7) -->
        <dependency>
            <groupId>org.projectnessie.cel</groupId>
            <artifactId>cel-tools</artifactId>
            <version>${cel-java.version}</version>
        </dependency>

        <!-- RFC 8785 (JCS) canonical JSON — the cross-engine dag_run_id anchor (A6).
             Reference implementation; the celpy/Python side must agree byte-for-byte,
             which the shared conformance suite (src/test/resources/conformance) enforces. -->
        <dependency>
            <groupId>io.github.erdtman</groupId>
            <artifactId>java-json-canonicalization</artifactId>
            <version>${jcs.version}</version>
        </dependency>

        <!-- Observability (ems-design §10, Amendment A11: Prometheus PULL is the transport).
             The prometheus registry is what makes /actuator/prometheus exist — without it the
             endpoint exposed in application.yml is a no-op. OTLP stays on the classpath but its
             export is disabled by default; it is one property away for a collector environment. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>

        <!-- NOTE (§10, azure profile): passwordless Azure PG auth is added when the target
             environment is wired, via the Spring Cloud Azure BOM + starter:
               com.azure.spring:spring-cloud-azure-dependencies (BOM, 5.x)
               com.azure.spring:spring-cloud-azure-starter-jdbc-postgresql
             Left out of the default build so local/Testcontainers runs need no Azure identity;
             the JDBC URL properties (authentication=azure) activate it in-cluster. -->

        <!-- ===================== test ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Surefire runs *Test (unit); Failsafe runs *IT (Testcontainers integration). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      The §12 perf harness seeds ~10 M events. It is an *IT like the others, so it would
                      otherwise be picked up by every `mvn verify` and turn a two-minute build into an
                      hour. Excluded by tag here and re-enabled by -Pperf below; untagged ITs are
                      unaffected, which is why the existing suite still runs.

                      Driven by PROPERTIES rather than by a profile that re-declares this <configuration>.
                      A profile-level <configuration combine.self="override"> would discard what this
                      block inherits from spring-boot-starter-parent — in particular <classesDirectory>,
                      which points Failsafe at target/classes instead of the fat jar that
                      spring-boot:repackage leaves behind. Without it every IT fails discovery with
                      NoClassDefFoundError on a main class, and the message says nothing about the cause.
                    -->
                    <groups>${ems.it.groups}</groups>
                    <excludedGroups>${ems.it.excludedGroups}</excludedGroups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          -Pperf runs the §12 harness and NOTHING else: swapping the tag filter from "exclude perf" to
          "include only perf" means the ordinary ITs are skipped rather than run alongside a 10 M-row
          seed. Unit tests still run (Surefire is untouched) — they are seconds, and a perf run against a
          broken build is noise.

          CI invokes this from a workflow_dispatch-only job. It requires Docker; without one the harness
          self-skips like every other IT and the run reports zero tests, which is an honest "not measured"
          rather than a green tick.
        -->
        <profile>
            <id>perf</id>
            <properties>
                <ems.it.groups>perf</ems.it.groups>
                <ems.it.excludedGroups />
            </properties>
        </profile>
    </profiles>
</project>
