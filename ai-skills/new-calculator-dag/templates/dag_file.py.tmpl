import pendulum
from airflow.decorators import dag
from orchestration.common.base_task import calc_end, calc_start
from orchestration.common.constants import DAG_DEFAULT_ARGUMENTS
from dags.control.dag_constants import CAPITAL_TAGS
from {{logic_module_import_path}} import {{get_group_function}}


@dag(
    dag_id="{{dag_id}}",
    description="{{description}}",
    default_args=DAG_DEFAULT_ARGUMENTS,
    tags=[{{tags}}],
    # schedule=None: routing is the registry's job. A schedule here would create a
    # second, uncoordinated trigger channel (authoring-contract.md §10).
    schedule=None,
    start_date=pendulum.datetime(year=2021, month=1, day=1, tz="Europe/Zurich"),
    catchup=False,
)
def {{dag_id}}():
    start = calc_start()
    calc_group = {{get_group_function}}({{group_function_args}})
    finish = calc_end()

    start >> calc_group >> finish


# Module-level invocation — without this call Airflow never registers the DAG.
{{dag_id}}()
